  panel1: {fileID: 4492726800202564701}
  panel2: {fileID: 4492726801016524171}
  questionData:
  - question: The _____ and <u><b>queen</b></u> met us.
    questionAudioClip: {fileID: 8300000, guid: 715ae07f7d9086a47938c990ad13b76f, type: 3}
    options:
    - optionSTR: prince
      optionClip: {fileID: 8300000, guid: 846282d7217b67f4eb5275ff32d29a7f, type: 3}
      isRight: 0
    - optionSTR: king
      optionClip: {fileID: 8300000, guid: 61ecedffc5c0b1a4b8d701ee4345b226, type: 3}
      isRight: 1
  - question: Bina has two <u><b>brothers</b></u> and one _____.
    questionAudioClip: {fileID: 8300000, guid: ef3b43f4c1c613c499afa8bb520ed21a, type: 3}
    options:
    - optionSTR: boy
      optionClip: {fileID: 8300000, guid: 624a972752760874983638b445471c95, type: 3}
      isRight: 0
    - optionSTR: sister
      optionClip: {fileID: 8300000, guid: 4f00b9faf5724c242882d8374dd01820, type: 3}
      isRight: 1
  - question: The <u><b>bull</b></u> and _____ ate grass.
    questionAudioClip: {fileID: 8300000, guid: 7a08b53a4974edd40b3cbac451d51d0d, type: 3}
    options:
    - optionSTR: cow
      optionClip: {fileID: 8300000, guid: c340f0c7e80fec04cbb655bf4da76e33, type: 3}
      isRight: 1
    - optionSTR: duck
      optionClip: {fileID: 8300000, guid: a369f6026655c684994b12ec30465eed, type: 3}
      isRight: 0
  - question: My <u><b>aunt</b></u> came home and my _____ gave me a gift.
    questionAudioClip: {fileID: 8300000, guid: ce617f0c427e8cc46875765f87c95931, type: 3}
    options:
    - optionSTR: uncle
      optionClip: {fileID: 8300000, guid: 74c5325332f9a584bab47bd6bb4eb069, type: 3}
      isRight: 1
    - optionSTR: brother
      optionClip: {fileID: 8300000, guid: e5589f967e941a542a60f768a9716a80, type: 3}
      isRight: 0
  - question: _____ can run faster than the <u><b>lion</b></u>.
    questionAudioClip: {fileID: 8300000, guid: ecc7a2647ad61e640a746bcfcc35d2ec, type: 3}
    options:
    - optionSTR: Tigress
      optionClip: {fileID: 8300000, guid: 6e5ce62202cfab34f9f8d33a48f2f5da, type: 3}
      isRight: 0
    - optionSTR: Lioness
      optionClip: {fileID: 8300000, guid: b614eba01e8f7904b89a22dfd8d268d8, type: 3}
      isRight: 1
  - question: A <u><b>cock</b></u> cannot lay eggs, like the _____.
    questionAudioClip: {fileID: 8300000, guid: 6e220d012847e3e4a96f8e9f1306f002, type: 3}
    options:
    - optionSTR: hen
      optionClip: {fileID: 8300000, guid: d0ff7e9b82bd1a8408d1725301e70e54, type: 3}
      isRight: 1
    - optionSTR: duck
      optionClip: {fileID: 8300000, guid: a369f6026655c684994b12ec30465eed, type: 3}
      isRight: 0
